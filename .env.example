# Contact form delivery (https://resend.com). Copy to .env.local and fill in.
RESEND_API_KEY=
# Where enquiries are delivered. Defaults to the email in src/content/site.ts.
CONTACT_TO_EMAIL=
# Sender; must be a domain verified in Resend. Defaults to Resend's test sender.
CONTACT_FROM_EMAIL=

# CV variants (https://upstash.com, or Vercel's Upstash integration, which sets these names).
# Without them, development stores variants in .data/cv-variants.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Bearer token agents send to the CV MCP endpoint (/api/mcp). Make it long and random.
CV_MCP_TOKEN=
# Public origin used in the links the MCP hands back. Defaults to the request's own origin.
NEXT_PUBLIC_SITE_URL=
