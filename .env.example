# Contact form delivery (https://resend.com). Copy to .env.local and fill in.
RESEND_API_KEY=
# Where enquiries are delivered. Defaults to the email in src/content/site.ts.
CONTACT_TO_EMAIL=
# Sender; must be a domain verified in Resend. Defaults to Resend's test sender.
CONTACT_FROM_EMAIL=
# Most enquiries a day, site-wide (default 80, below Resend's free 100, which the dashboard's emailed
# setup links share). Raise it on a paid Resend plan.
CONTACT_DAILY_CAP=

# CV variants, short links and dashboard sign-in limits (https://upstash.com, or Vercel's Upstash
# integration, which sets these names). Without them, development keeps everything in .data/.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Bearer token agents send to the CV MCP endpoint (/api/mcp). Make it long and random.
CV_MCP_TOKEN=
# Public origin used in the links the MCP and the dashboard hand out. Defaults to the request's own origin.
NEXT_PUBLIC_SITE_URL=

# Analytics: a PostHog project API key (EU cloud, eu.posthog.com). Without it, nothing is tracked.
NEXT_PUBLIC_POSTHOG_KEY=
# The number in your PostHog project URL (eu.posthog.com/project/<id>), so the dashboard feed links straight to replays.
NEXT_PUBLIC_POSTHOG_PROJECT_ID=

# Dashboard sign-in (/dashboard) is set up on the site itself, by an emailed link, and kept in Upstash. Leave this
# empty. Set it (a base32 TOTP secret) only to fix the secret by hand; the setup page then can't replace it.
DASHBOARD_TOTP_SECRET=

# Dashboard Assistant (Upwork cover letters and screening answers). Either an Anthropic API key, or Vercel's AI Gateway:
# AI_GATEWAY_API_KEY, which a Vercel deployment can also replace with its own OIDC token once AI Gateway is enabled.
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
# Optional: another Claude model (default claude-opus-5-5). A full Gateway id such as anthropic/claude-sonnet-5.5 also works.
ASSISTANT_MODEL=
