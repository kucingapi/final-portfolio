# Contact form delivery (https://resend.com). Copy to .env.local and fill in.
RESEND_API_KEY=
# Where enquiries are delivered. Defaults to the email in src/content/site.ts.
CONTACT_TO_EMAIL=
# Sender; must be a domain verified in Resend. Defaults to Resend's test sender.
CONTACT_FROM_EMAIL=

# CV variants, short links and dashboard sign-in limits (https://upstash.com, or Vercel's Upstash
# integration, which sets these names). Without them, development keeps everything in .data/.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Bearer token agents send to the CV MCP endpoint (/api/mcp). Make it long and random.
CV_MCP_TOKEN=
# Public origin used in the links the MCP and the dashboard hand out. Defaults to the request's own origin.
NEXT_PUBLIC_SITE_URL=

# Analytics: a PostHog project API key (EU cloud, eu.posthog.com). Without it, nothing is tracked.
NEXT_PUBLIC_POSTHOG_KEY=

# Dashboard sign-in (/dashboard): the base32 TOTP secret your authenticator app holds. Leave it empty and open
# http://localhost:3000/dashboard/setup to make one. Changing it signs every device out.
DASHBOARD_TOTP_SECRET=
